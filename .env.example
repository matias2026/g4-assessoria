# Supabase (plano gratuito) — em Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: apenas em variáveis de servidor, nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=

# Strava API (app gratuito em https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Gemini API (camada gratuita em https://aistudio.google.com/apikey) — usada
# para gerar o rascunho de feedback pós-treino que o treinador revisa.
GEMINI_API_KEY=

# Rate limiting (login e rotas de API) roda no próprio Postgres do Supabase
# (ver supabase/migrations/0006_rate_limit_via_postgres.sql) — não precisa
# de nenhuma variável nova, usa as mesmas credenciais do Supabase acima.
