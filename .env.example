# Supabase (plano gratuito) — em Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: apenas em variáveis de servidor, nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=

# Strava API (app gratuito em https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Gemini API (camada gratuita em https://aistudio.google.com/apikey) — usada
# para gerar o rascunho de feedback pós-treino que o treinador revisa.
GEMINI_API_KEY=

# Upstash Redis (plano gratuito em https://console.upstash.com — crie um
# banco "Redis", copie a "REST URL" e o "REST Token" da tela do banco).
# Usado para rate limiting (login e rotas de API) por IP. Sem essas duas
# variáveis o app funciona normalmente, só que sem o limite de requisições.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
